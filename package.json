{
  "name": "taskflow-qa-automation",
  "version": "1.0.0",
  "description": "Playwright and TypeScript QA automation portfolio covering UI, API, and data validation",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test tests/ui --workers=1",
    "test:api": "playwright test --config=playwright.api.config.ts",
    "test:all": "playwright test tests/ui --workers=1 && playwright test --config=playwright.api.config.ts",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
